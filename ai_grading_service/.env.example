# 模型 provider。联调占位可用 mock；真实调用改为 openai_compatible。
AI_PIPELINE_PROVIDER=mock

# 是否保存模型原始输出 raw_response.json。正式环境建议 false，本地排查问题时再改 true。
AI_GRADING_SAVE_RAW_OUTPUT=false

# 作业评价独立复核模式：off 不调用；shadow 调用但不覆盖顶层结论；visible 调用并公开复核结论。
HOMEWORK_REVIEW_MODE=off

# 视觉 OCR 模型配置。使用 image_path 或 image_url 时需要配置。
VISUAL_MODEL_API_KEY=
VISUAL_MODEL_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
VISUAL_MODEL_NAME=doubao-seed-2-0-lite-260215
VISUAL_MODEL_TIMEOUT_SECONDS=180
VISUAL_MODEL_RETRY_COUNT=2
VISUAL_MODEL_TEMPERATURE=0
VISUAL_MODEL_MAX_TOKENS=131072
VISUAL_MODEL_REASONING_EFFORT=
VISUAL_MODEL_THINKING_TYPE=disabled

# 批改、证据风险、解法分析模型配置。
GRADING_MODEL_API_KEY=
GRADING_MODEL_BASE_URL=https://api.deepseek.com
GRADING_MODEL_NAME=deepseek-v4-flash
GRADING_MODEL_TIMEOUT_SECONDS=120
GRADING_MODEL_RETRY_COUNT=2
GRADING_MODEL_TEMPERATURE=0
GRADING_MODEL_MAX_TOKENS=131072
GRADING_MODEL_REASONING_EFFORT=high
GRADING_MODEL_THINKING_TYPE=enabled

# 复核决策模型配置。留空时默认复用 GRADING_MODEL_*。
GATE_MODEL_API_KEY=
GATE_MODEL_BASE_URL=
GATE_MODEL_NAME=
GATE_MODEL_TIMEOUT_SECONDS=120
GATE_MODEL_RETRY_COUNT=2
GATE_MODEL_TEMPERATURE=0
GATE_MODEL_MAX_TOKENS=32768
GATE_MODEL_REASONING_EFFORT=high
GATE_MODEL_THINKING_TYPE=enabled
